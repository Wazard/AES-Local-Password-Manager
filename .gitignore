# --- Virtual env / IDE ---
.venv/
.vscode/
.idea/

# --- Python caches ---
__pycache__/
*.pyc
*.pyo

# --- Nuitka build artifacts ---
main.build/
main.dist/
main.onefile-build/
*.exe

# --- Installer output / downloaded tools ---
installer/
innosetup-*.exe
*.xpi

# --- Distribution archives ---
*.zip

# --- User data & secrets (never commit) ---
*.pwmanager
*.pwmanager.tmp
extension_config.json
vault_location.json
debug_log.txt
github.txt

# --- Misc / temp ---
sv_backup_result.json
sec_*.py
*.ps1
*.iss
# ...except the build tooling: installer.iss carries the AppId that makes
# installs upgrade in place instead of stacking up, so it must not be lost.
!build.ps1
!installer.iss
installer.iss.bak

# --- iOS (the Xcode project is generated from ios/project.yml) ---
ios/*.xcodeproj/
ios/build/
*.ipa

# --- Android (Gradle output; signing keys never go in the repository) ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab
*.jks
*.keystore
